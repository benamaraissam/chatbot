{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "chatbot-angular": {
      "projectType": "library",
      "root": "projects/chatbot-angular",
      "sourceRoot": "projects/chatbot-angular/src",
      "prefix": "cb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/chatbot-angular/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/chatbot-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/chatbot-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/chatbot-angular/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"],
            "karmaConfig": "karma.conf.js",
            "main": "projects/chatbot-angular/src/test.ts"
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/demo",
            "index": "projects/demo/src/index.html",
            "browser": "projects/demo/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": ["projects/demo/src/favicon.ico"],
            "styles": [
              "projects/demo/src/styles.css",
              "projects/chatbot-angular/src/lib/styles/chatbot-angular.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial", "maximumWarning": "500kb", "maximumError": "1mb"},
                {"type": "anyComponentStyle", "maximumWarning": "2kb", "maximumError": "4kb"}
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget": "demo:build:production"},
            "development": {"buildTarget": "demo:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "3e692666-83a6-44c6-a524-2da2b7ac4d75"
  }
}
