# Copy to .env and fill in values:
#   cp .env.example .env
#
# Used by examples/02_fastapi_app.py and optional `chatbot serve` (via load_project_dotenv).

# --- OpenAI-compatible provider (OpenAI, Moonshot, Ollama, Azure, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.ai/v1

# Model id on your gateway (Moonshot example: kimi-k2.5, kimi-k2.6, moonshot-v1-8k, …)
CHATBOT_OPENAI_MODEL=kimi-k2.6

# Optional: force stream_options.include_usage (1=on, 0=off). Default: on for api.openai.com only.
# OPENAI_STREAM_USAGE=0

# mock | openai
CHATBOT_DEFAULT_PROVIDER=openai

# --- Anthropic (optional) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
