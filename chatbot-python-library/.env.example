# =============================================================================
# Chatbot library — example environment file.
#
#   cp .env.example .env
#
# Loaded automatically by examples/02_web_apps/{fastapi,flask,django}_app.py
# (via chatbot.env.load_dotenv_file) and by the standalone `chatbot serve`
# command (via load_project_dotenv).
#
# Each provider section is independent. Set credentials only for the
# providers you want to use — the example will register just those and
# fall back to "mock" otherwise.
# =============================================================================


# -----------------------------------------------------------------------------
# Active provider — which one bot.py picks as the default for new conversations.
# Accepted values: mock | openai | azure | claude
# If the requested provider has no credentials configured below, bot.py
# falls back to "mock" automatically.
# -----------------------------------------------------------------------------
CHATBOT_DEFAULT_PROVIDER=mock

# Optional system prompt override.
# CHATBOT_SYSTEM_PROMPT="You are a helpful assistant for our internal CRM."

# Optional storage backend. "memory" | "sqlite:///./chatbot.db" | <postgres dsn>
# CHATBOT_STORAGE=memory

# Max LLM ↔ tool rounds per user turn before the agent forces a final
# wrap-up answer. Default 10 in code; raise for tools that paginate deeply.
# CHATBOT_MAX_TOOL_ROUNDS=10


# =============================================================================
# OpenAI / OpenAI-compatible gateways (Ollama, vLLM, Moonshot, Together, …)
# =============================================================================

# Required to register the "openai" provider in bot.py.
OPENAI_API_KEY=

# Endpoint root. Defaults to https://api.openai.com/v1. Examples:
#   https://api.moonshot.ai/v1
#   http://localhost:11434/v1            (Ollama)
#   https://api.together.xyz/v1          (Together)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model id served at the chosen endpoint.
# Examples: gpt-4o, gpt-4o-mini, kimi-k2.6, llama3.2, mistral-large-latest
CHATBOT_OPENAI_MODEL=gpt-4o

# Force `stream_options.include_usage` on/off. Default: on for *.openai.com
# and *.openai.azure.com only. Some gateways 400 on it.
#   1=on, 0=off
# OPENAI_STREAM_USAGE=0


# =============================================================================
# Azure OpenAI
# =============================================================================

# Required to register the "azure" provider in bot.py.
# Endpoint format: https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Auth — pick ONE of: api-key OR Entra ID (AAD) bearer token.
AZURE_OPENAI_API_KEY=

# Name of the deployment in your Azure portal (not the underlying model name).
AZURE_OPENAI_DEPLOYMENT=gpt-4o-prod

# Azure API version. Default 2024-10-21 (the first GA with stream_options.include_usage).
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: Azure AD / Entra ID token. If set, bot.py would need to enable
# `extra.use_aad`. See README for the AAD-only configuration block.
# AZURE_OPENAI_AD_TOKEN=


# =============================================================================
# Anthropic Claude
# =============================================================================

# Required to register the "claude" provider in bot.py.
ANTHROPIC_API_KEY=

# Optional model override. Default: claude-sonnet-4-20250514.
# CHATBOT_CLAUDE_MODEL=claude-opus-4-7

# Optional: custom endpoint (Bedrock / Vertex / proxy).
# ANTHROPIC_BASE_URL=


# =============================================================================
# Django variant (django_app.py) — optional knobs.
# =============================================================================

# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=replace-me-in-production


# =============================================================================
# Per-app overrides
# =============================================================================

# Override the bind port for the active variant (defaults: fastapi 8000,
# flask 5000, django 8001).
# PORT=8000
