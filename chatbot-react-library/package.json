{
  "name": "chatbot-react",
  "version": "0.1.0",
  "description": "Embeddable React chatbot with SSE streaming",
  "type": "module",
  "license": "MIT",
  "main": "./dist/chatbot-react.umd.cjs",
  "module": "./dist/chatbot-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chatbot-react.js",
      "require": "./dist/chatbot-react.umd.cjs"
    },
    "./styles.css": "./dist/chatbot-react.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "peerDependencies": {
    "react": "^17.0.0",
    "react-dom": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "framer-motion": "^6.5.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^8.0.7",
    "remark-gfm": "^3.0.1",
    "shiki": "^1.24.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^12.1.5",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.25",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
